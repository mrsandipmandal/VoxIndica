# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WORKER_TIMEOUT_MS: how long /api/tts waits for a Kaggle/Colab/local VoxCPM2 worker.
# Inference on a T4 takes tens of seconds per request; do not lower this below 60000.
WORKER_TIMEOUT_MS="120000"

# Creator Studio script providers. At least one is required for script generation.
# Fallback order is Gemini → Groq → OpenRouter; keys never reach the browser.
# GEMINI_SCRIPT_MODEL="gemini-2.5-flash"
# GROQ_API_KEY=""
# GROQ_SCRIPT_MODEL="llama-3.3-70b-versatile"
# OPENROUTER_API_KEY=""
# OPENROUTER_SCRIPT_MODEL="google/gemini-2.5-flash"

# Optional: pin the local worker token instead of the random per-session token.
# The same value must be entered in the Studio's Local Hardware panel.
# VOXINDICA_WORKER_TOKEN=""

# Batch inference callbacks. The Studio always starts a dedicated loopback
# listener (default port 3099) that exposes only the signed webhook route.
# Local workers can call it directly. Kaggle/Colab workers need a public tunnel
# to that listener and an explicit VOXINDICA_PUBLIC_URL; without it the Studio
# returns 503 instead of pretending remote callbacks work.
# VOXINDICA_CALLBACK_PORT="3099"
# VOXINDICA_PUBLIC_URL="https://your-callback-tunnel.example.com"
# VOXINDICA_BATCH_DATA_DIR=""

# Kaggle credentials are NOT stored here. The Studio keeps them in browser storage
# and sends them per request to /api/providers/kaggle/*, which proxies to
# https://www.kaggle.com/api/v1.

